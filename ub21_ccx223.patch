+	 (strcmp1(&lakon[8*i+1],"B32")==0)||
 	 (strcmp1(&lakon[8*i+1],"S45")==0)||
 	 (strcmp1(&lakon[8*i+1],"S3")==0)){
 	  
diff -u -N a/nodebelongstoel.f b/nodebelongstoel.f
--- a/nodebelongstoel.f
+++ b/nodebelongstoel.f
@@ -31,7 +31,10 @@
       do i=1,ne
          if(ipkon(i).lt.0) cycle
          if(lakon(i)(1:1).eq.'F') cycle
-         if(lakon(i)(4:4).eq.'2') then
+!        Evaluate user elements first to avoid matching UB32's '2' at position 4 under lakon(i)(4:4)=='2' (which sets nope=20)
+         if(lakon(i)(1:1).eq.'U') then
+            nope=ichar(lakon(i)(8:8))
+         else if(lakon(i)(4:4).eq.'2') then
             nope=20
          elseif(lakon(i)(4:4).eq.'8') then
             nope=8
diff -u -N a/resultsmech_ub21.f b/resultsmech_ub21.f
--- a/resultsmech_ub21.f	1970-01-01 01:00:00.000000000 +0100
+++ b/resultsmech_ub21.f	2026-07-30 09:40:23.318411678 +0200
@@ -0,0 +1,813 @@
+!
+!     CalculiX - A 3-dimensional finite element program
+!              Copyright (C) 1998-2025 Guido Dhondt
+!
