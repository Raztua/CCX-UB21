+      ! Transform s: S_node = T^T * S_beam * T
+      ! Temp = S_beam * T
+      do i = 1, n
+         do j = 1, n
+            Temp(i,j) = 0.d0
+            do k = 1, n
+               Temp(i,j) = Temp(i,j) + s(i,k) * T(k,j)
+            enddo
+         enddo
+      enddo
+      ! s = T^T * Temp
+      do i = 1, n
+         do j = 1, n
+            s(i,j) = 0.d0
+            do k = 1, n
+               s(i,j) = s(i,j) + T(k,i) * Temp(k,j)
+            enddo
+         enddo
+      enddo
+
+      ! Transform sm if mass = 1: SM_node = T^T * SM_beam * T
+      if (mass .eq. 1) then
+         do i = 1, n
+            do j = 1, n
+               Temp(i,j) = 0.d0
+               do k = 1, n
+                  Temp(i,j) = Temp(i,j) + sm(i,k) * T(k,j)
+               enddo
+            enddo
+         enddo
