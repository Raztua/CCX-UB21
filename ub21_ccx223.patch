 !     
@@ -127,7 +133,7 @@
             lprop=lprop+1
             if(lprop.gt.ndprop) exit
             read(textpart(k),'(f20.0)',iostat=istat) 
-     &           prop(nprop+lprop)
+     &           prop(npropstart+lprop)
             if(istat.gt.0) then
               call inputerror(inpc,ipoinpc,iline,
      &             "*USER SECTION%",ier)
@@ -135,7 +141,7 @@
             endif
           enddo
         enddo
-        nprop=nprop+ndprop
+        nprop=npropstart+ndprop
       else
         call getnewline(inpc,textpart,istat,n,key,iline,ipol,inl,
